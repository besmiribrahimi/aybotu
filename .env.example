# Discord Bot Token
TOKEN=your_discord_bot_token_here

# MongoDB Connection URI
# For local MongoDB: mongodb://localhost:27017/vincentbot
# For MongoDB Atlas: mongodb+srv://username:password@cluster.xxxxx.mongodb.net/vincentbot
MONGODB_URI=mongodb://localhost:27017/vincentbot

# Client ID (for deploying commands)
CLIENT_ID=your_client_id_here
